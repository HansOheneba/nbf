# Absolute site URL. Used for canonical links and the Paystack return page.
# Example: https://example.org
NEXT_PUBLIC_SITE_URL=

# Optional. If set, the general /donate page redirects here.
# Red for a Reason does not use this URL. Its gifts go through Paystack.
NEXT_PUBLIC_DONATION_URL=

# Paystack secret key for Red for a Reason. Server-side only.
# Leave unset until the campaign account is ready. The site will not
# describe a donation as received without a verified Paystack transaction.
PAYSTACK_SECRET_KEY=

# Optional. Comma-separated methods already enabled and tested on that account.
# Supported: card, mobile_money, bank, bank_transfer
# If unset, checkout can still open, but the site does not name a method.
PAYSTACK_CHANNELS=

# Campaign and other enquiry forms need one of these before they can
# confirm that a message was sent.
INQUIRY_WEBHOOK_URL=

# Or Resend. INQUIRY_FROM_EMAIL must be a sender Resend has verified.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
